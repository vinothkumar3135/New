pipeline {
    agent any

    environment {
        BRANCH      = 'New'
        SSH_CRED_ID = 'pem-key'                       // Jenkins credential holding your .pem key
        EC2_HOST    = 'ubuntu@43.204.150.240'        // e.g. ubuntu@13.233.10.20
        REPO_URL    = 'https://github.com/vinothkumar3135/New.git'
        APP_DIR     = '/home/ubuntu/Backend-new'
        ENV_SRC     = '/home/ubuntu/env-new.env'
        IMAGE_NAME  = 'inf-backend-new'
        CONTAINER   = 'infoez-new'
        HOST_PORT   = '8000'
    }

    stages {
        stage('Deploy to my EC2') {
            steps {
                sshagent([env.SSH_CRED_ID]) {
                    sh '''
                        ssh -o StrictHostKeyChecking=accept-new "$EC2_HOST" "BRANCH=$BRANCH REPO_URL=$REPO_URL APP_DIR=$APP_DIR ENV_SRC=$ENV_SRC IMAGE_NAME=$IMAGE_NAME CONTAINER=$CONTAINER HOST_PORT=$HOST_PORT bash -s" <<'REMOTE'
set -eu

# Create the shared Docker network if it doesn't exist yet
docker network inspect my-app-network >/dev/null 2>&1 || docker network create my-app-network

if [ ! -d "$APP_DIR/.git" ]; then
    git clone --branch "$BRANCH" --single-branch "$REPO_URL" "$APP_DIR"
fi
cd "$APP_DIR"
git fetch origin "$BRANCH"
git checkout -f "$BRANCH"
git reset --hard "origin/$BRANCH"

[ -s "$ENV_SRC" ] || { echo "Missing $ENV_SRC on EC2. Upload your .env there first."; exit 1; }
cp "$ENV_SRC" .env

docker build -t "$IMAGE_NAME" .
docker ps -q --filter "publish=$HOST_PORT" | xargs -r docker rm -f
docker rm -f "$CONTAINER" 2>/dev/null || true
docker run -d --name "$CONTAINER" --restart unless-stopped \
    --network my-app-network --env-file .env \
    -p "$HOST_PORT:8000" "$IMAGE_NAME"

for i in $(seq 1 30); do
    if curl -fs "http://127.0.0.1:$HOST_PORT/health" >/dev/null; then
        echo "Health check passed for branch $BRANCH"
        exit 0
    fi
    sleep 2
done
docker logs --tail 100 "$CONTAINER"
exit 1
REMOTE
                    '''
                }
            }
        }
    }
}
