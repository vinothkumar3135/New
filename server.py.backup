async def admin_users(user: dict = Depends(require_role('admin'))):
    users = await db.users.find({}, {'_id': 0, 'password': 0}).sort('created_at', -1).to_list(1000)
    return users

@api.patch("/admin/users/{uid}/role")
async def admin_set_role(uid: str, role: str = Query(...), user: dict = Depends(require_role('admin'))):
    if role not in ('customer', 'business_owner', 'admin'):
        raise HTTPException(400, "Invalid role")
    await db.users.update_one({'id': uid}, {'$set': {'role': role}})
    return {'ok': True}

@api.delete("/admin/users/{uid}")
async def admin_delete_user(uid: str, user: dict = Depends(require_role('admin'))):
    if uid == user['id']:
        raise HTTPException(400, "Cannot delete self")
    await db.users.delete_one({'id': uid})
    return {'ok': True}

