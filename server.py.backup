@api.post("/seed")
async def seed_data():
    # Idempotent seed
    if await db.categories.count_documents({}) > 0:
        # if already seeded, just return counts
        return {
            'ok': True, 'already_seeded': True,
            'users': await db.users.count_documents({}),
            'businesses': await db.businesses.count_documents({}),
            'categories': await db.categories.count_documents({}),
        }
    # categories
    cats = []
    for c in DEFAULT_CATEGORIES:
        doc = {'id': new_id(), 'name': c['name'], 'slug': slugify(c['name']),
               'icon': c['icon'], 'color': c['color'], 'created_at': now_iso()}
        cats.append(doc)
    await db.categories.insert_many(cats)
    cat_by_name = {c['name']: c for c in cats}

    # admin user
    admin = {
        'id': new_id(), 'name': 'Infoez Admin', 'email': 'admin@infoez.com',
        'password': hash_password('Admin@123'), 'role': 'admin', 'phone': None, 'avatar': None,
        'created_at': now_iso(),
    }
    owner = {
        'id': new_id(), 'name': 'Ravi Kumar', 'email': 'owner@infoez.com',
        'password': hash_password('Owner@123'), 'role': 'business_owner', 'phone': '+91 90000 00000', 'avatar': None,
        'created_at': now_iso(),
    }
    customer = {
        'id': new_id(), 'name': 'Priya Sharma', 'email': 'customer@infoez.com',
        'password': hash_password('Customer@123'), 'role': 'customer', 'phone': '+91 91111 11111', 'avatar': None,
        'created_at': now_iso(),
    }
    await db.users.insert_many([admin, owner, customer])

    # businesses + seed reviews to make ratings coherent
    biz_docs = []
    review_docs = []
    for i, (name, cat_name, desc, city, addr, services, rating, lat, lng) in enumerate(SAMPLE_BUSINESSES):
        cat = cat_by_name.get(cat_name)
        bid = new_id()
        review_rating = int(round(rating))
        review_docs.append({
            'id': new_id(), 'business_id': bid, 'user_id': customer['id'],
            'rating': review_rating, 'comment': "Great experience — friendly staff, quality service, would recommend.",
            'created_at': now_iso(),
        })
        biz_docs.append({
            'id': bid,
            'owner_id': owner['id'] if i % 2 == 0 else admin['id'],
            'slug': slugify(name) + f"-{i+1}",
            'name': name, 'description': desc,
            'category_id': cat['id'] if cat else None,
            'address': addr, 'city': city,
            'lat': lat, 'lng': lng,
            'phone': f"+91 9{80000000 + i * 1234}", 'email': f"hello@{slugify(name)}.in",
            'website': f"https://{slugify(name)}.in",
            'services': services,
            'images': [SAMPLE_IMAGES[i % len(SAMPLE_IMAGES)], SAMPLE_IMAGES[(i+1) % len(SAMPLE_IMAGES)]],
            'price_range': ['$', '$$', '$$$'][i % 3],
            'hours': 'Mon-Sun 9:00 AM - 10:00 PM',
            'rating': float(review_rating), 'review_count': 1, 'view_count': 100 + i * 15,
            'verified': i % 3 != 0, 'featured': i < 4, 'status': 'active',
            'created_at': now_iso(),
        })
    await db.businesses.insert_many(biz_docs)
    await db.reviews.insert_many(review_docs)

    return {
        'ok': True, 'seeded': True,
        'admin_email': 'admin@infoez.com', 'admin_password': 'Admin@123',
        'owner_email': 'owner@infoez.com', 'owner_password': 'Owner@123',
        'customer_email': 'customer@infoez.com', 'customer_password': 'Customer@123',
    }

# --- Uploads ---
MIME_TYPES = {"jpg": "image/jpeg", "jpeg": "image/jpeg", "png": "image/png",
              "gif": "image/gif", "webp": "image/webp"}
MAX_UPLOAD_BYTES = 8 * 1024 * 1024  # 8MB per file

@api.post("/uploads")
async def upload_file(file: UploadFile = File(...), user: dict = Depends(get_current_user)):
    ext = (file.filename or "").rsplit(".", 1)[-1].lower() if "." in (file.filename or "") else "bin"
    if ext not in MIME_TYPES:
        raise HTTPException(400, "Only jpg, jpeg, png, gif, webp allowed")
    data = await file.read()
    if len(data) > MAX_UPLOAD_BYTES:
        raise HTTPException(413, "File too large (max 8MB)")
    content_type = MIME_TYPES[ext]
    path = f"{APP_NAME}/uploads/{user['id']}/{uuid.uuid4()}.{ext}"
    try:
        result = put_object(path, data, content_type)
    except Exception as e:
        _logger.exception("upload failed")
        raise HTTPException(500, f"Storage error: {e}")
    await db.files.insert_one({
        'id': new_id(), 'user_id': user['id'],
        'storage_path': result['path'],
        'original_filename': file.filename,
        'content_type': content_type, 'size': result.get('size', len(data)),
        'is_deleted': False, 'created_at': now_iso(),
    })
    # public url served by our GET /api/files/{path:path}
    public_url = f"/api/files/{result['path']}"
    return {'path': result['path'], 'url': public_url, 'size': result.get('size', len(data))}

@api.get("/files/{path:path}")
async def download_file(path: str):
    # Business photos are publicly viewable (like Justdial / Yelp).
    rec = await db.files.find_one({'storage_path': path, 'is_deleted': False})
    if not rec:
        raise HTTPException(404, "File not found")
    try:
        data, ctype = get_object(path)
    except Exception:
        raise HTTPException(404, "File not found")
    return Response(content=data, media_type=rec.get('content_type', ctype),
                    headers={"Cache-Control": "public, max-age=86400"})

