# --- Businesses ---
def business_out(b: dict) -> dict:
    return {k: v for k, v in b.items() if k != '_id'}

@api.get("/businesses")
async def list_businesses(
    q: Optional[str] = None,
    category_id: Optional[str] = None,
    city: Optional[str] = None,
    min_rating: Optional[float] = None,
    verified: Optional[bool] = None,
    sort: Optional[str] = None,
    featured: Optional[bool] = None,
    near_lat: Optional[float] = None,
    near_lng: Optional[float] = None,
    radius_km: Optional[float] = 25,
    include_pending: Optional[bool] = False,
    limit: int = 24,
    skip: int = 0,
    user: Optional[dict] = Depends(get_current_user_optional),
):
    query = {}
    # visibility: only active by default; admin can request all via include_pending
    if not (include_pending and user and user['role'] == 'admin'):
        query['status'] = 'active'
    if q:
        eq = re.escape(q)
        query['$or'] = [
            {'name': {'$regex': eq, '$options': 'i'}},
            {'description': {'$regex': eq, '$options': 'i'}},
            {'services': {'$elemMatch': {'$regex': eq, '$options': 'i'}}},
        ]
    if category_id: query['category_id'] = category_id
    if city: query['city'] = {'$regex': f'^{re.escape(city)}$', '$options': 'i'}
    if min_rating is not None: query['rating'] = {'$gte': min_rating}
    if verified is not None: query['verified'] = verified
    if featured: query['featured'] = True

    sort_spec = [('created_at', -1)]
    if sort == 'rating': sort_spec = [('rating', -1), ('review_count', -1)]
    elif sort == 'popular': sort_spec = [('view_count', -1), ('review_count', -1)]

    # If nearby search, fetch a larger set then filter in Python (small dataset)
    if near_lat is not None and near_lng is not None:
        cursor = db.businesses.find(query, {'_id': 0}).sort(sort_spec).limit(500)
        raw = await cursor.to_list(500)
        def haversine(lat1, lon1, lat2, lon2):
            R = 6371.0
            p1 = math.radians(lat1); p2 = math.radians(lat2)
            dphi = math.radians(lat2 - lat1); dl = math.radians(lon2 - lon1)
            a = math.sin(dphi/2)**2 + math.cos(p1)*math.cos(p2)*math.sin(dl/2)**2
            return 2*R*math.asin(math.sqrt(a))
        with_dist = []
        for b in raw:
            if b.get('lat') is None or b.get('lng') is None: continue
            d = haversine(near_lat, near_lng, b['lat'], b['lng'])
            if d <= (radius_km or 25):
                b['distance_km'] = round(d, 2)
                with_dist.append(b)
        with_dist.sort(key=lambda x: x['distance_km'])
        return {'items': with_dist[skip:skip+limit], 'total': len(with_dist)}

    cursor = db.businesses.find(query, {'_id': 0}).sort(sort_spec).skip(skip).limit(limit)
    items = await cursor.to_list(limit)
    total = await db.businesses.count_documents(query)
    return {'items': items, 'total': total}

@api.get("/businesses/{slug}")
async def get_business(slug: str, user: Optional[dict] = Depends(get_current_user_optional)):
    b = await db.businesses.find_one({'slug': slug}, {'_id': 0})
    if not b:
        b = await db.businesses.find_one({'id': slug}, {'_id': 0})
    if not b:
        raise HTTPException(404, "Business not found")
    # increment view
    await db.businesses.update_one({'id': b['id']}, {'$inc': {'view_count': 1}})
    # check if favorited
    is_fav = False
    if user:
        fav = await db.favorites.find_one({'user_id': user['id'], 'business_id': b['id']})
        is_fav = bool(fav)
    b['is_favorited'] = is_fav
    # category name
    if b.get('category_id'):
        cat = await db.categories.find_one({'id': b['category_id']}, {'_id': 0})
        b['category'] = cat
    return b

@api.post("/businesses")
async def create_business(data: BusinessIn, user: dict = Depends(require_role('business_owner', 'admin'))):
    slug_base = slugify(data.name)
    slug = slug_base
    i = 1
    while await db.businesses.find_one({'slug': slug}):
        i += 1
        slug = f"{slug_base}-{i}"
    # Admin-created listings are auto-approved; owners land in pending queue.
    status = 'active' if user['role'] == 'admin' else 'pending'
    biz = {
        'id': new_id(),
        'owner_id': user['id'],
        'slug': slug,
        **data.model_dump(),
        'rating': 0.0,
        'review_count': 0,
        'view_count': 0,
        'verified': user['role'] == 'admin',
        'featured': False,
        'status': status,
        'created_at': now_iso(),
    }
    await db.businesses.insert_one(biz)
    # Notify all admins on new pending listing
    if status == 'pending':
        admins = await db.users.find({'role': 'admin'}, {'_id': 0, 'id': 1}).to_list(100)
        for a in admins:
            await db.notifications.insert_one({
                'id': new_id(), 'user_id': a['id'],
                'title': 'New listing pending review',
                'body': f"'{biz['name']}' by {user['name']} is awaiting approval.",
                'type': 'pending_listing', 'read': False, 'created_at': now_iso(),
            })
    return business_out(biz)

@api.put("/businesses/{bid}")
async def update_business(bid: str, data: BusinessUpdate, user: dict = Depends(get_current_user)):
    biz = await db.businesses.find_one({'id': bid})
    if not biz:
        raise HTTPException(404, "Business not found")
    if biz['owner_id'] != user['id'] and user['role'] != 'admin':
        raise HTTPException(403, "Not your business")
    upd = {k: v for k, v in data.model_dump().items() if v is not None}
    if upd:
        await db.businesses.update_one({'id': bid}, {'$set': upd})
    fresh = await db.businesses.find_one({'id': bid}, {'_id': 0})
    return fresh

@api.delete("/businesses/{bid}")
async def delete_business(bid: str, user: dict = Depends(require_role('admin'))):
    biz = await db.businesses.find_one({'id': bid})
    if not biz:
        raise HTTPException(404, "Business not found")
    await db.businesses.delete_one({'id': bid})
    await db.reviews.delete_many({'business_id': bid})
    await db.favorites.delete_many({'business_id': bid})
    await db.enquiries.delete_many({'business_id': bid})
    return {'ok': True}

@api.post("/businesses/{bid}/verify")
async def verify_business(bid: str, user: dict = Depends(require_role('admin'))):
    biz = await db.businesses.find_one({'id': bid})
    if not biz:
        raise HTTPException(404, "Business not found")
    await db.businesses.update_one({'id': bid}, {'$set': {'verified': True}})
    await db.notifications.insert_one({
        'id': new_id(), 'user_id': biz['owner_id'],
        'title': 'Business Verified', 'body': f"Your business '{biz['name']}' was verified by admin.",
        'type': 'verified', 'read': False, 'created_at': now_iso(),
    })
    return await db.businesses.find_one({'id': bid}, {'_id': 0})

@api.post("/businesses/{bid}/approve")
async def approve_business(bid: str, user: dict = Depends(require_role('admin'))):
    biz = await db.businesses.find_one({'id': bid})
    if not biz:
        raise HTTPException(404, "Business not found")
    await db.businesses.update_one({'id': bid}, {'$set': {'status': 'active'}})
    await db.notifications.insert_one({
        'id': new_id(), 'user_id': biz['owner_id'],
        'title': 'Listing Approved',
        'body': f"Your listing '{biz['name']}' is now live on Infoez.",
        'type': 'approved', 'read': False, 'created_at': now_iso(),
    })
    return await db.businesses.find_one({'id': bid}, {'_id': 0})

@api.post("/businesses/{bid}/reject")
async def reject_business(bid: str, reason: str = Query("Does not meet our guidelines"), user: dict = Depends(require_role('admin'))):
    biz = await db.businesses.find_one({'id': bid})
    if not biz:
        raise HTTPException(404, "Business not found")
    await db.businesses.update_one({'id': bid}, {'$set': {'status': 'rejected'}})
    await db.notifications.insert_one({
        'id': new_id(), 'user_id': biz['owner_id'],
        'title': 'Listing Rejected',
        'body': f"Your listing '{biz['name']}' was rejected. Reason: {reason}",
        'type': 'rejected', 'read': False, 'created_at': now_iso(),
    })
    return await db.businesses.find_one({'id': bid}, {'_id': 0})

@api.get("/admin/pending-businesses")
async def pending_businesses(user: dict = Depends(require_role('admin'))):
    items = await db.businesses.find({'status': 'pending'}, {'_id': 0}).sort('created_at', -1).to_list(500)
    for b in items:
        owner = await db.users.find_one({'id': b['owner_id']}, {'_id': 0, 'password': 0})
        b['owner'] = {'name': owner['name'], 'email': owner['email']} if owner else None
    return items

@api.post("/businesses/{bid}/feature")
async def feature_business(bid: str, user: dict = Depends(require_role('admin'))):
    biz = await db.businesses.find_one({'id': bid})
    if not biz:
        raise HTTPException(404, "Business not found")
    new_val = not biz.get('featured', False)
    await db.businesses.update_one({'id': bid}, {'$set': {'featured': new_val}})
    return await db.businesses.find_one({'id': bid}, {'_id': 0})

@api.get("/businesses/owner/me")
async def my_businesses(user: dict = Depends(require_role('business_owner', 'admin'))):
    items = await db.businesses.find({'owner_id': user['id']}, {'_id': 0}).to_list(200)
    return items

# --- Reviews ---
@api.get("/businesses/{bid}/reviews")
async def list_reviews(bid: str):
    reviews = await db.reviews.find({'business_id': bid}, {'_id': 0}).sort('created_at', -1).to_list(500)
    for r in reviews:
        u = await db.users.find_one({'id': r['user_id']}, {'_id': 0})
        r['user'] = {'name': u['name'], 'avatar': u.get('avatar')} if u else None
    return reviews

@api.post("/businesses/{bid}/reviews")
async def add_review(bid: str, data: ReviewIn, user: dict = Depends(get_current_user)):
    biz = await db.businesses.find_one({'id': bid})
    if not biz:
        raise HTTPException(404, "Business not found")
    # one review per user per business (upsert)
    review = {
        'id': new_id(), 'business_id': bid, 'user_id': user['id'],
        'rating': data.rating, 'comment': data.comment, 'created_at': now_iso(),
    }
    await db.reviews.delete_many({'business_id': bid, 'user_id': user['id']})
    await db.reviews.insert_one(review)
    # recalc rating
    all_r = await db.reviews.find({'business_id': bid}).to_list(2000)
    avg = sum(r['rating'] for r in all_r) / len(all_r)
    await db.businesses.update_one({'id': bid}, {'$set': {'rating': round(avg, 1), 'review_count': len(all_r)}})
    # notify owner
    await db.notifications.insert_one({
        'id': new_id(), 'user_id': biz['owner_id'],
        'title': 'New Review', 'body': f"{user['name']} left a {data.rating}-star review on '{biz['name']}'",
        'type': 'review', 'read': False, 'created_at': now_iso(),
    })
    return {k: v for k, v in review.items() if k != '_id'}

@api.get("/reviews/me")
async def my_reviews(user: dict = Depends(get_current_user)):
    reviews = await db.reviews.find({'user_id': user['id']}, {'_id': 0}).sort('created_at', -1).to_list(500)
    for r in reviews:
        b = await db.businesses.find_one({'id': r['business_id']}, {'_id': 0})
        r['business'] = {'name': b['name'], 'slug': b['slug'], 'images': b.get('images', [])} if b else None
    return reviews

@api.delete("/reviews/{rid}")
async def delete_review(rid: str, user: dict = Depends(get_current_user)):
    r = await db.reviews.find_one({'id': rid})
    if not r:
        raise HTTPException(404, "Not found")
    if r['user_id'] != user['id'] and user['role'] != 'admin':
        raise HTTPException(403, "Forbidden")
    bid = r['business_id']
    await db.reviews.delete_one({'id': rid})
    all_r = await db.reviews.find({'business_id': bid}).to_list(2000)
    avg = (sum(x['rating'] for x in all_r) / len(all_r)) if all_r else 0.0
    await db.businesses.update_one({'id': bid}, {'$set': {'rating': round(avg, 1), 'review_count': len(all_r)}})
    return {'ok': True}

# --- Favorites ---
@api.get("/favorites/me")
async def my_favorites(user: dict = Depends(get_current_user)):
    favs = await db.favorites.find({'user_id': user['id']}, {'_id': 0}).to_list(500)
    ids = [f['business_id'] for f in favs]
    businesses = await db.businesses.find({'id': {'$in': ids}}, {'_id': 0}).to_list(500)
    return businesses

@api.post("/favorites/{bid}")
async def add_fav(bid: str, user: dict = Depends(get_current_user)):
    existing = await db.favorites.find_one({'user_id': user['id'], 'business_id': bid})
    if existing:
        return {'ok': True, 'favorited': True}
    await db.favorites.insert_one({'id': new_id(), 'user_id': user['id'], 'business_id': bid, 'created_at': now_iso()})
    return {'ok': True, 'favorited': True}

@api.delete("/favorites/{bid}")
async def remove_fav(bid: str, user: dict = Depends(get_current_user)):
    await db.favorites.delete_one({'user_id': user['id'], 'business_id': bid})
    return {'ok': True, 'favorited': False}

# --- Enquiries ---
@api.post("/businesses/{bid}/enquiries")
async def create_enquiry(bid: str, data: EnquiryIn, user: Optional[dict] = Depends(get_current_user_optional)):
    biz = await db.businesses.find_one({'id': bid})
    if not biz:
        raise HTTPException(404, "Business not found")
    e = {
        'id': new_id(), 'business_id': bid, 'business_name': biz['name'],
        'user_id': user['id'] if user else None,
        **data.model_dump(), 'status': 'new', 'created_at': now_iso(),
    }
    await db.enquiries.insert_one(e)
    await db.notifications.insert_one({
        'id': new_id(), 'user_id': biz['owner_id'],
        'title': 'New Lead / Enquiry', 'body': f"{data.name} sent an enquiry for '{biz['name']}'",
        'type': 'enquiry', 'read': False, 'created_at': now_iso(),
    })
    return {k: v for k, v in e.items() if k != '_id'}

