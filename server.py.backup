# --- Subscriptions ---
PLANS = [
    {'id': 'free', 'name': 'Free', 'price': 0, 'features': ['Basic listing', 'Up to 5 photos', 'Customer reviews']},
    {'id': 'starter', 'name': 'Starter', 'price': 19, 'features': ['Everything in Free', 'Up to 20 photos', 'Priority support', 'Lead tracking']},
    {'id': 'pro', 'name': 'Pro', 'price': 49, 'features': ['Everything in Starter', 'Featured placement', 'Verified badge fast-track', 'Analytics dashboard']},
    {'id': 'enterprise', 'name': 'Enterprise', 'price': 149, 'features': ['Everything in Pro', 'Multiple locations', 'Dedicated success manager', 'API access']},
]

@api.get("/subscriptions/plans")
async def get_plans():
    return PLANS

@api.get("/subscriptions/me")
async def my_subscription(user: dict = Depends(get_current_user)):
    sub = await db.subscriptions.find_one({'user_id': user['id']}, {'_id': 0})
    if not sub:
        return {'plan_id': 'free', 'status': 'active'}
    return sub

@api.post("/subscriptions/subscribe")
async def subscribe(data: SubscribeIn, user: dict = Depends(get_current_user)):
    plan = next((p for p in PLANS if p['id'] == data.plan_id), None)
    if not plan:
        raise HTTPException(400, "Invalid plan")
    sub = {
        'id': new_id(), 'user_id': user['id'], 'plan_id': data.plan_id,
        'plan_name': plan['name'], 'status': 'active',
        'started_at': now_iso(), 'renews_at': (datetime.now(timezone.utc) + timedelta(days=30)).isoformat(),
    }
    await db.subscriptions.delete_many({'user_id': user['id']})
    await db.subscriptions.insert_one(sub)
    return {k: v for k, v in sub.items() if k != '_id'}

# --- Claims ---
@api.post("/businesses/{bid}/claim")
async def claim_business(bid: str, data: ClaimIn, user: dict = Depends(get_current_user)):
    biz = await db.businesses.find_one({'id': bid})
    if not biz:
        raise HTTPException(404, "Business not found")
    existing = await db.claims.find_one({'business_id': bid, 'user_id': user['id'], 'status': 'pending'})
    if existing:
        raise HTTPException(400, "Claim already pending")
    c = {
        'id': new_id(), 'business_id': bid, 'business_name': biz['name'],
        'user_id': user['id'], 'user_name': user['name'], 'user_email': user['email'],
        'reason': data.reason, 'proof_url': data.proof_url,
        'status': 'pending', 'created_at': now_iso(),
    }
    await db.claims.insert_one(c)
    return {k: v for k, v in c.items() if k != '_id'}

@api.get("/claims/me")
async def my_claims(user: dict = Depends(get_current_user)):
    items = await db.claims.find({'user_id': user['id']}, {'_id': 0}).sort('created_at', -1).to_list(200)
    return items

@api.get("/claims")
async def all_claims(user: dict = Depends(require_role('admin'))):
    items = await db.claims.find({}, {'_id': 0}).sort('created_at', -1).to_list(500)
    return items

@api.post("/claims/{cid}/approve")
async def approve_claim(cid: str, user: dict = Depends(require_role('admin'))):
    c = await db.claims.find_one({'id': cid})
    if not c:
        raise HTTPException(404, "Not found")
    await db.claims.update_one({'id': cid}, {'$set': {'status': 'approved'}})
    await db.businesses.update_one({'id': c['business_id']}, {'$set': {'owner_id': c['user_id'], 'verified': True}})
    await db.users.update_one({'id': c['user_id']}, {'$set': {'role': 'business_owner'}})
    await db.notifications.insert_one({
        'id': new_id(), 'user_id': c['user_id'],
        'title': 'Claim Approved', 'body': f"Your claim for '{c['business_name']}' was approved. You are now the owner.",
        'type': 'claim', 'read': False, 'created_at': now_iso(),
    })
    return {'ok': True}

@api.post("/claims/{cid}/reject")
async def reject_claim(cid: str, user: dict = Depends(require_role('admin'))):
    c = await db.claims.find_one({'id': cid})
    if not c:
        raise HTTPException(404, "Not found")
    await db.claims.update_one({'id': cid}, {'$set': {'status': 'rejected'}})
    await db.notifications.insert_one({
        'id': new_id(), 'user_id': c['user_id'],
        'title': 'Claim Rejected', 'body': f"Your claim for '{c['business_name']}' was rejected.",
        'type': 'claim', 'read': False, 'created_at': now_iso(),
    })
    return {'ok': True}

